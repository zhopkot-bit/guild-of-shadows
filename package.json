{
  "name": "guild-of-shadows",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx tools/sim.ts",
    "qa:saves": "tsx tools/qa/make-saves.ts qa-saves",
    "qa:e2e": "node tools/qa/e2e.mjs http://127.0.0.1:4173/ qa-out/e2e",
    "qa:shot": "node tools/qa/shot.mjs",
    "qa:record": "node tools/qa/record.mjs",
    "art:build": "python tools/art/build_assets.py"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
